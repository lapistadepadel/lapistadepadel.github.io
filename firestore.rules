rules_version = '2';
// Reglas de seguridad de la app de pádel. Cópialas entera en Firebase > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }

    match /groups/{g} {
      function grp() { return get(/databases/$(database)/documents/groups/$(g)).data; }
      function isOwner() { return signedIn() && grp().owner == request.auth.uid; }
      function isAdmin() { return isOwner() || (signedIn() && request.auth.uid in grp().admins); }
      function isMember() { return isAdmin() || (signedIn() && myEmail() in grp().emails); }

      // The group itself: name, owner, admins and the Gmail allow-list.
      allow read: if signedIn() && (resource.data.owner == request.auth.uid || myEmail() in resource.data.emails);
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.admins.size() == 0
        && myEmail() in request.resource.data.emails;
      allow update: if signedIn() && (
          // owner: everything except handing over ownership
          (resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner)
          // co-admins: only the Gmail allow-list
          || (request.auth.uid in resource.data.admins && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emails']))
        );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /players/{id} {
        allow read: if isMember();
        allow create: if isMember() && (request.resource.data.uid == request.auth.uid || request.resource.data.uid == null);
        allow update: if isAdmin() || (isMember() && (
            resource.data.uid == request.auth.uid
            || (resource.data.uid == null && request.resource.data.uid == request.auth.uid)));
        allow delete: if isAdmin();
      }
      match /matches/{id} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.by == request.auth.uid;
        allow update, delete: if isAdmin();
      }
      match /tresults/{id} {
        allow read: if isMember();
        allow create, update: if isMember();
        allow delete: if isAdmin();
      }
      match /events/{id} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
      match /tournaments/{id} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
      match /rsvp/{uid} {
        allow read: if isMember();
        allow write: if isMember() && (request.auth.uid == uid || isAdmin());
      }
    }
  }
}
